---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { internalPath } from '../lib/paths';
const { title = 'Guillermo Blanco Vera | Formación tecnológica', description = 'Cloud, AWS, programación e Inteligencia Artificial desde la experiencia práctica.', lang = 'es' } = Astro.props;
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><link rel="icon" type="image/svg+xml" href={internalPath('/favicon.svg')}/><title>{title}</title></head><body><Header currentPath={Astro.url.pathname} {lang}/><main><slot /></main><Footer {lang}/></body></html>
<style is:global>@import '../styles/global.css';</style>
