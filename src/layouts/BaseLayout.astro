---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title = 'Guillermo Blanco Vera | Formación tecnológica', description = 'Cloud, AWS, programación e Inteligencia Artificial desde la experiencia práctica.' } = Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title}</title></head><body><Header currentPath={Astro.url.pathname}/><main><slot /></main><Footer /></body></html>
<style is:global>@import '../styles/global.css';</style>
