---
import { internalPath } from '../lib/paths';
const { lang = 'es', currentPath = '/' } = Astro.props;
const localPath = currentPath.replace(/^\/en(?=\/|$)/, '') || '/';
---
<div class="language-switcher no-print" aria-label="Language selector"><a class:list={{ active: lang === 'es' }} href={internalPath(localPath)}>ES</a><span>/</span><a class:list={{ active: lang === 'en' }} href={internalPath(`/en${localPath === '/' ? '' : localPath}`)}>EN</a></div>
<style>.language-switcher{display:flex;align-items:center;gap:4px;color:var(--muted);font-size:.75rem;font-weight:700}.language-switcher a{padding:2px;color:inherit}.language-switcher a.active{color:var(--blue)}</style>
