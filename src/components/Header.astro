---
import { internalPath } from '../lib/paths';
import LanguageSwitcher from './LanguageSwitcher.astro';
const { currentPath = '' } = Astro.props;
const links = [['Inicio','/'],['Cursos','/courses'],['Experiencia','/about'],['Contacto','/contact']];
---
<header class="no-print">
  <div class="container nav"><div class="brand-space"></div><nav id="primary-navigation">{links.map(([label,href]) => <a data-i18n={label} class:list={{active: currentPath === href}} href={internalPath(href)}>{label}</a>)}</nav><div class="nav-actions"><LanguageSwitcher/><a data-i18n="Hablemos" class="nav-cta" href={internalPath('/contact')}>Hablemos</a><button class="menu-toggle" aria-expanded="false" aria-controls="primary-navigation" aria-label="Abrir menú"><span></span><span></span><span></span></button></div></div>
<script>
  const menuButton = document.querySelector('.menu-toggle');
  const menu = document.querySelector('#primary-navigation');
  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!open)); menu?.classList.toggle('open', !open);
  });
</script>
</header>
<style>
header{background:rgba(246,248,251,.88);backdrop-filter:blur(12px);position:sticky;top:0;z-index:5;border-bottom:1px solid transparent}.nav{height:74px;display:flex;align-items:center;justify-content:space-between;gap:25px}.brand-space{width:105px}.nav-actions{display:flex;align-items:center;gap:14px;min-width:105px;justify-content:flex-end}nav{display:flex;gap:25px;color:var(--muted);font-size:.94rem;font-weight:600}nav a.active,nav a:hover{color:var(--blue)}.nav-cta{font-size:.87rem;font-weight:700;border:1px solid var(--line);padding:7px 12px;border-radius:7px}.menu-toggle{display:none;width:38px;height:38px;padding:8px;border:1px solid var(--line);border-radius:7px;background:#fff;cursor:pointer}.menu-toggle span{display:block;height:2px;background:var(--ink);margin:4px 0;border-radius:2px}@media(max-width:650px){.brand-space,.nav-cta{display:none}.nav{height:62px;justify-content:flex-end}.menu-toggle{display:block}nav{display:none;position:absolute;top:62px;left:0;right:0;padding:12px 20px 20px;background:var(--canvas);border-bottom:1px solid var(--line);flex-direction:column;gap:3px}nav.open{display:flex}nav a{padding:10px 0}}
</style>
