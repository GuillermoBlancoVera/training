---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { ui, type Lang } from '../i18n/ui';
import { localizedPath } from '../lib/paths';

interface Props {
  lang: Lang;
  route: string;
}

const { lang, route } = Astro.props;
const t = ui[lang].nav;
const links = [
  [t.home, '/'],
  [t.courses, '/courses'],
  [t.about, '/about'],
  [t.contact, '/contact'],
] as const;
const isActive = (href: string) => (href === '/' ? route === '/' : route === href || route.startsWith(`${href}/`));
---

<header>
  <div class="container nav">
    <a class="brand" href={localizedPath(lang)}>
      Guillermo Blanco Vera
    </a>
    <nav id="primary-navigation" aria-label={t.mainNav}>
      {links.map(([label, href]) => (
        <a
          class:list={{ active: isActive(href) }}
          href={localizedPath(lang, href)}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
    <div class="nav-actions">
      <LanguageSwitcher lang={lang} route={route} />
      <a class="nav-cta" href={localizedPath(lang, '/contact')}>
        {t.cta}
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-navigation"
        aria-label={t.openMenu}
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const menuButton = document.querySelector('.menu-toggle');
  const menu = document.querySelector('#primary-navigation');
  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('open', !open);
  });
</script>

<style>
  header {
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .nav {
    height: 74px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
  }
  .brand {
    font-family: var(--font-heading);
    font-weight: 800;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: 25px;
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 600;
  }
  nav a.active,
  nav a:hover {
    color: var(--blue);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .nav-cta {
    font-size: 0.87rem;
    font-weight: 700;
    border: 1px solid var(--line);
    padding: 7px 12px;
    border-radius: 7px;
  }
  .menu-toggle {
    display: none;
    width: 38px;
    height: 38px;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--paper);
    cursor: pointer;
  }
  .menu-toggle span {
    display: block;
    height: 2px;
    background: var(--ink);
    margin: 4px 0;
    border-radius: 2px;
  }
  @media (max-width: 860px) {
    .nav-cta {
      display: none;
    }
  }
  @media (max-width: 650px) {
    .nav {
      height: 62px;
      gap: 12px;
    }
    .menu-toggle {
      display: block;
    }
    nav {
      display: none;
      position: absolute;
      top: 62px;
      left: 0;
      right: 0;
      padding: 12px 20px 20px;
      background: var(--canvas);
      border-bottom: 1px solid var(--line);
      flex-direction: column;
      gap: 3px;
    }
    nav.open {
      display: flex;
    }
    nav a {
      padding: 10px 0;
    }
  }
</style>
