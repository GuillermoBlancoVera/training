---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/CourseCard.astro';
import { ui, type Lang } from '../i18n/ui';
import { getCourses } from '../lib/courses';
import { localizedPath } from '../lib/paths';
import { person, website } from '../lib/structured-data';
import { categories } from '../lib/taxonomy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const featured = (await getCourses(lang)).filter((course) => course.data.featured).slice(0, 3);
const icons = {
  cloud: '<path d="M7 18h10a4 4 0 0 0 .5-7.97A5.5 5.5 0 0 0 7.1 8.44 4.8 4.8 0 0 0 7 18Z"/>',
  programming: '<path d="m8 9-3 3 3 3M16 9l3 3-3 3M14 5l-4 14"/>',
  ai: '<rect x="4" y="7" width="16" height="13" rx="4"/><path d="M12 3v4M8 13h.01M16 13h.01M8 17h8"/><path d="M3 12h1M20 12h1"/>',
};
---

<BaseLayout lang={lang} structuredData={[website(lang, Astro.site), person(lang, Astro.site)]}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Guillermo Blanco Vera</p>
      <h1>{t.home.heading}</h1>
      <p class="lead">{t.home.lead}</p>
      <div class="button-row">
        <a class="button" href={localizedPath(lang, '/courses')}>
          {t.home.viewCourses}
        </a>
        <a class="button secondary" href={localizedPath(lang, '/about')}>
          {t.home.viewExperience}
        </a>
      </div>
      <div class="hero-note">
        {t.home.highlights.map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{t.home.areasEyebrow}</p>
          <h2>{t.home.areasHeading}</h2>
        </div>
      </div>
      <div class="grid grid-3 areas">
        {categories.map((category) => (
          <article class="card">
            <span class="area-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                set:html={icons[category]}
              />
            </span>
            <h3>{t.categories[category]}</h3>
            <p>{t.home.areas[category]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section featured">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{t.home.featuredEyebrow}</p>
          <h2>{t.home.featuredHeading}</h2>
        </div>
        <a class="button secondary" href={localizedPath(lang, '/courses')}>
          {t.home.fullCatalogue}
        </a>
      </div>
      <div class="grid grid-3">
        {featured.map((course) => (
          <CourseCard course={course} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">{t.home.experienceEyebrow}</p>
        <h2>{t.home.experienceHeading}</h2>
      </div>
      <div>
        <p class="lead">{t.home.experienceText}</p>
        <a class="text-link" href={localizedPath(lang, '/about')}>
          {t.home.experienceLink}
        </a>
      </div>
    </div>
  </section>

  <section class="section certifications">
    <div class="container">
      <p class="eyebrow">{t.home.certificationsEyebrow}</p>
      <div class="grid grid-2">
        {t.certifications.map(([name, text]) => (
          <article class="card">
            <h3>{name}</h3>
            <p class="muted">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container callout">
      <p class="eyebrow">{t.home.ctaEyebrow}</p>
      <h2>{t.home.ctaHeading}</h2>
      <p>{t.home.ctaText}</p>
      <a class="button" href={localizedPath(lang, '/contact')}>
        {t.home.ctaButton}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 125px 0 96px;
    background: var(--hero-gradient);
  }
  .hero h1 {
    margin-bottom: 20px;
  }
  .hero .button-row {
    margin-top: 32px;
  }
  .hero-note {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    margin-top: 70px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--muted);
  }
  .area-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--surface);
    color: var(--blue);
  }
  .area-icon svg {
    width: 24px;
    height: 24px;
  }
  .areas h3 {
    margin: 20px 0 8px;
  }
  .areas p {
    margin: 0;
    color: var(--muted);
  }
  .featured {
    background: var(--surface);
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 90px;
  }
  .text-link {
    color: var(--blue);
    font-weight: 700;
  }
  .certifications {
    padding-top: 0;
  }
  @media (max-width: 720px) {
    .hero {
      padding: 80px 0 60px;
    }
    .split {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
