---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import CourseCard from '../../components/CourseCard.astro';
const courses=(await getCollection('courses')).sort((a,b)=>a.data.order-b.data.order); const categories=['Cloud & AWS','Programación','Inteligencia Artificial'];
---
<BaseLayout title="Cursos | Guillermo Blanco Vera"><section class="page-head"><div class="container"><p class="eyebrow">Catálogo de formación</p><h1>Cursos para entender, decidir y construir mejor.</h1><p class="lead">Sesiones claras y prácticas para empresas y profesionales. Cada formación puede adaptarse al nivel, tiempo y objetivos del equipo.</p></div></section><section class="section"><div class="container"><div class="filters no-print">{categories.map((category)=><button data-filter={category}>{category}</button>)}<button class="active" data-filter="all">Todos</button></div>{categories.map(category=><section class="course-group" data-category={category}><p class="eyebrow">{category}</p><div class="grid grid-3">{courses.filter(c=>c.data.category===category).map(course=><CourseCard {course}/>)}</div></section>)}</div></section><section class="learning-paths section"><div class="container"><p class="eyebrow">Itinerarios de aprendizaje</p><h2>Recorridos conectados para avanzar con sentido.</h2><div class="grid grid-3"><article class="card"><h3>Cloud & AWS esencial</h3><p class="muted">Para entender Cloud y establecer una base práctica en AWS.</p><div class="path-courses"><span>Cloud Computing para profesionales</span><b>→</b><span>Introducción a AWS</span><b>→</b><span>AWS práctico</span></div></article><article class="card"><h3>Construir en AWS</h3><p class="muted">Para equipos que ya conocen lo básico y necesitan diseñar sistemas mantenibles.</p><div class="path-courses"><span>AWS práctico</span><b>→</b><span>Serverless</span><b>→</b><span>Infrastructure as Code</span></div></article><article class="card"><h3>IA aplicada</h3><p class="muted">Para comprender la IA generativa y llevarla a productos y procesos.</p><div class="path-courses"><span>IA para profesionales</span><b>→</b><span>GenAI en AWS</span><b>→</b><span>Desarrollo de aplicaciones GenAI</span></div></article></div></div></section></BaseLayout>
<script>document.querySelectorAll('[data-filter]').forEach(button => button.addEventListener('click', () => { const filter=button.dataset.filter; document.querySelectorAll('[data-filter]').forEach(b=>b.classList.toggle('active',b===button)); document.querySelectorAll('.course-group').forEach(group=>group.classList.toggle('hidden', filter !== 'all' && group.dataset.category !== filter)); }));</script>
<style>.page-head{padding:100px 0 55px;background:#e8f0fc}.page-head .button{margin-top:22px}.learning-paths{background:#edf2f8}.learning-paths h2{margin-bottom:32px}.path-courses{display:flex;align-items:center;gap:7px;margin-top:20px;color:var(--blue);font-size:.77rem;font-weight:700}.path-courses span{flex:1;padding:8px;background:#fff;border:1px solid #d4dfec;border-radius:7px;line-height:1.3}.path-courses b{font-size:1rem}.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:46px}.filters button{background:#fff;border:1px solid var(--line);color:var(--muted);padding:8px 12px;border-radius:7px;font:600 .85rem inherit;cursor:pointer}.filters button.active{background:var(--ink);color:#fff;border-color:var(--ink)}.course-group{margin-bottom:70px}.course-group>.eyebrow{border-bottom:1px solid var(--line);padding-bottom:12px}.hidden{display:none}@media(max-width:720px){.path-courses{align-items:stretch;flex-direction:column}.path-courses b{align-self:center;transform:rotate(90deg)}}</style>
