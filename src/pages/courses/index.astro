---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import CourseCard from '../../components/CourseCard.astro';
const courses=(await getCollection('courses')).sort((a,b)=>a.data.order-b.data.order); const categories=['Cloud & AWS','Programación','Inteligencia Artificial'];
---
<BaseLayout title="Cursos | Guillermo Blanco Vera"><section class="page-head"><div class="container"><p class="eyebrow">Catálogo de formación</p><h1>Cursos para entender, decidir y construir mejor.</h1><p class="lead">Sesiones claras y prácticas para empresas y profesionales. Cada formación puede adaptarse al nivel, tiempo y objetivos del equipo.</p><button class="button secondary no-print" onclick="window.print()">Descargar / imprimir catálogo</button></div></section><section class="learning-paths section"><div class="container"><p class="eyebrow">Itinerarios de aprendizaje</p><h2>Recorridos conectados para avanzar con sentido.</h2><div class="grid grid-3"><article class="card"><h3>Cloud & AWS esencial</h3><p class="muted">Para entender Cloud y establecer una base práctica en AWS.</p><p class="path-courses">Cloud Computing para profesionales <b>→</b> Introducción a AWS <b>→</b> AWS práctico</p></article><article class="card"><h3>Construir en AWS</h3><p class="muted">Para equipos que ya conocen lo básico y necesitan diseñar sistemas mantenibles.</p><p class="path-courses">AWS práctico <b>→</b> Serverless <b>→</b> Infrastructure as Code</p></article><article class="card"><h3>IA aplicada</h3><p class="muted">Para comprender la IA generativa y llevarla a productos y procesos.</p><p class="path-courses">IA para profesionales <b>→</b> GenAI en AWS <b>→</b> Desarrollo de aplicaciones GenAI</p></article></div></div></section><section class="section"><div class="container"><div class="filters no-print">{categories.map((category)=><button data-filter={category}>{category}</button>)}<button class="active" data-filter="all">Todos</button></div>{categories.map(category=><section class="course-group" data-category={category}><p class="eyebrow">{category}</p><div class="grid grid-3">{courses.filter(c=>c.data.category===category).map(course=><CourseCard {course}/>)}</div></section>)}</div></section></BaseLayout>
<script>document.querySelectorAll('[data-filter]').forEach(button => button.addEventListener('click', () => { const filter=button.dataset.filter; document.querySelectorAll('[data-filter]').forEach(b=>b.classList.toggle('active',b===button)); document.querySelectorAll('.course-group').forEach(group=>group.classList.toggle('hidden', filter !== 'all' && group.dataset.category !== filter)); }));</script>
<style>.page-head{padding:100px 0 55px;background:#e8f0fc}.page-head .button{margin-top:22px}.learning-paths{background:#edf2f8}.learning-paths h2{margin-bottom:32px}.path-courses{font-size:.85rem;color:var(--blue);font-weight:700}.path-courses b{margin:0 3px}.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:46px}.filters button{background:#fff;border:1px solid var(--line);color:var(--muted);padding:8px 12px;border-radius:7px;font:600 .85rem inherit;cursor:pointer}.filters button.active{background:var(--ink);color:#fff;border-color:var(--ink)}.course-group{margin-bottom:70px}.course-group>.eyebrow{border-bottom:1px solid var(--line);padding-bottom:12px}.hidden{display:none}</style>
