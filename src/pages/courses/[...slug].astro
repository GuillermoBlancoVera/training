---
import { getCollection, render } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import CourseCard from '../../components/CourseCard.astro'; import { internalPath } from '../../lib/paths';
export async function getStaticPaths(){const courses=await getCollection('courses');return courses.map(course=>({params:{slug:course.id},props:{course}}));}
const { course }=Astro.props; const { Content }=await render(course); const related=(await getCollection('courses')).filter(item=>item.data.category===course.data.category&&item.id!==course.id).sort((a,b)=>a.data.order-b.data.order).slice(0,3);
---
<BaseLayout title={`${course.data.title} | Guillermo Blanco Vera`} description={course.data.description}><section class="course-hero"><div class="container"><a class="back no-print" href={internalPath('/courses')}>← Volver al catálogo</a><p class="eyebrow">{course.data.category}</p><h1>{course.data.title}</h1><p class="lead">{course.data.description}</p><div class="facts"><span>{course.data.level}</span><span>{course.data.duration}</span><span>{course.data.modality}</span></div><div class="button-row no-print"><a class="button" href={internalPath('/contact')}>Solicitar esta formación</a><button class="button secondary" onclick="window.print()">Imprimir ficha</button></div></div></section><section class="section"><div class="container course-layout"><div class="prose"><Content /></div><aside class="card details"><h3>Información del curso</h3><div><b>Dirigido a</b><ul>{course.data.audience.map(item=><li>{item}</li>)}</ul></div><div><b>Conocimientos previos</b><p>{course.data.prerequisites}</p></div><div><b>Posibles ejercicios</b><ul>{course.data.exercises.map(item=><li>{item}</li>)}</ul></div><div><b>Adaptación a empresas</b><p>{course.data.adaptation}</p></div></aside></div></section>{related.length>0&&<section class="section related"><div class="container"><p class="eyebrow">También puede interesarte</p><div class="grid grid-3">{related.map(course=><CourseCard {course}/>)}</div></div></section>}<section class="section"><div class="container callout"><h2>Formación adaptada al equipo.</h2><p>Podemos ajustar la duración, el nivel técnico y los ejercicios a las necesidades de tu organización.</p><a class="button" href={internalPath('/contact')}>Contactar</a></div></section></BaseLayout>
<style>.course-hero{padding:65px 0;background:#e8f0fc}.back{display:inline-block;color:var(--muted);font-weight:600;margin-bottom:38px}.facts{display:flex;flex-wrap:wrap;gap:10px;margin-top:27px}.facts span{background:#fff;border:1px solid var(--line);border-radius:7px;padding:7px 10px;font-size:.86rem;font-weight:700}.course-hero .button-row{margin-top:28px}.course-layout{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(290px,.8fr);gap:70px}.details{height:max-content}.details h3{margin-bottom:22px}.details div{border-top:1px solid var(--line);padding:15px 0}.details p,.details ul{font-size:.9rem;color:var(--muted);margin:7px 0 0;padding-left:18px}.related{background:#edf2f8}@media(max-width:720px){.course-layout{grid-template-columns:1fr;gap:32px}}</style>
