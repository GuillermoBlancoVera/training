---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import CourseCard from '../../components/CourseCard.astro'; import { internalPath } from '../../lib/paths';
const featured=(await getCollection('courses')).filter(c=>c.data.featured).sort((a,b)=>a.data.order-b.data.order).slice(0,3);
---
<BaseLayout lang="en" title="Guillermo Blanco Vera | Technology training" description="Cloud, AWS, programming and Artificial Intelligence explained through practical experience."><section class="hero"><div class="container"><p class="eyebrow">Guillermo Blanco Vera</p><h1>Technology training for companies and professionals.</h1><p class="lead">Cloud, AWS, programming and Artificial Intelligence explained through practical experience.</p><div class="button-row"><a class="button" href={internalPath('/en/courses')}>View courses</a><a class="button secondary" href={internalPath('/en/about')}>Explore my experience</a></div><div class="hero-note"><span>Senior Software Engineer</span><span>AWS · Backend · AI</span><span>10+ years of experience</span></div></div></section><section class="section"><div class="container"><p class="eyebrow">Training areas</p><h2>Clear concepts. Real-world application.</h2><div class="grid grid-3 areas"><article class="card"><h3>Cloud & AWS</h3><p>Architectures, services, security, cost and infrastructure as code to understand and build in the cloud.</p></article><article class="card"><h3>Programming</h3><p>Practical foundations and tools for automation, systems understanding and software development.</p></article><article class="card"><h3>Artificial Intelligence</h3><p>From AI foundations to generative applications, LLMs and AWS services.</p></article></div></div></section><section class="section featured"><div class="container"><p class="eyebrow">Featured courses</p><h2>Training that adapts to the context.</h2><div class="grid grid-3">{featured.map(course=><CourseCard {course} lang="en"/>)}</div></div></section><section class="section"><div class="container callout"><p class="eyebrow">Tailored training</p><h2>Looking for training adapted to your team?</h2><p>Courses can be adjusted in duration, level and content to suit each organisation.</p><a class="button" href={internalPath('/en/contact')}>Let's talk about training</a></div></section></BaseLayout>
<style>.hero{padding:125px 0 96px;background:linear-gradient(120deg,#f6f8fb 45%,#e8f0fc)}.hero h1{margin-bottom:20px}.hero .button-row{margin-top:32px}.hero-note{display:flex;gap:22px;flex-wrap:wrap;margin-top:70px;padding-top:20px;border-top:1px solid var(--line);font-size:.85rem;font-weight:700;color:var(--muted)}.areas h3{margin-top:0}.areas p{margin:0;color:var(--muted)}.featured{background:#edf2f8}</style>
