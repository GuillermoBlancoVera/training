import BaseLayout from '../../layouts/BaseLayout.astro'; import { internalPath } from '../../lib/paths';
---
<BaseLayout lang="en" title="Experience | Guillermo Blanco Vera"><section class="page-head"><div class="container about-intro"><div><p class="eyebrow">Professional experience</p><h1>More than 10 years building technology.</h1><p class="lead">A career spanning software, backend, Cloud, technical leadership and Artificial Intelligence, always focused on turning complex technology into useful systems.</p></div><img src={internalPath('/images/guillermo-blanco-vera.png')} alt="Guillermo Blanco Vera"/></div></section><section class="section"><div class="container"><div class="evolution">Software Development → Backend & Cloud → Technical Leadership → Artificial Intelligence → Enterprise AWS</div><div class="timeline"><article><p class="eyebrow">2024 — Present</p><h2>Volkswagen Digital:Hub</h2><h3>Software Engineer · Technical Lead</h3><p class="muted">AWS Cloud architectures and enterprise systems: data, integration, event-driven systems, observability and infrastructure as code.</p></article><article><p class="eyebrow">2023 — 2024</p><h2>Padmi</h2><h3>CTO</h3><p class="muted">Leading Computer Vision, iOS and Android teams; Cloud architecture, AI, backend and product decisions.</p></article><article><p class="eyebrow">2020 — 2023</p><h2>Alyze</h2><h3>CTO</h3><p class="muted">AI engine for emotion analysis through facial recognition, with technical, product and infrastructure responsibility.</p></article></div></div></section></BaseLayout><style>.page-head{padding:85px 0 55px;background:#e8f0fc}.about-intro{display:grid;grid-template-columns:1fr 210px;align-items:center;gap:70px}.about-intro img{width:210px;height:210px;object-fit:cover;object-position:center 38%;border-radius:50%;border:7px solid rgba(255,255,255,.75)}.evolution{background:var(--ink);color:#fff;padding:22px;border-radius:12px;font-weight:700}.timeline{max-width:800px;margin:70px auto}.timeline article{padding:0 0 42px 28px;border-left:1px solid var(--line)}.timeline h2{font-size:1.8rem;margin-bottom:4px}.timeline h3{font-family:'DM Sans';letter-spacing:0;font-size:1rem}@media(max-width:720px){.about-intro{grid-template-columns:1fr;gap:24px}.about-intro img{width:150px;height:150px;grid-row:1}}</style>
