---
import { getCollection } from 'astro:content'; import BaseLayout from '../../../layouts/BaseLayout.astro'; import CourseCard from '../../../components/CourseCard.astro'; import { categoryEn } from '../../../i18n/en';
const courses=(await getCollection('courses')).sort((a,b)=>a.data.order-b.data.order); const categories=['Cloud & AWS','Programación','Inteligencia Artificial'];
---
<BaseLayout lang="en" title="Courses | Guillermo Blanco Vera"><section class="page-head"><div class="container"><p class="eyebrow">Training catalogue</p><h1>Courses to understand, make decisions and build better.</h1><p class="lead">Clear, practical sessions for companies and professionals. Every course can be adapted to the team's level, time and goals.</p></div></section><section class="section"><div class="container">{categories.map(category=><section class="course-group"><p class="eyebrow">{categoryEn[category]}</p><div class="grid grid-3">{courses.filter(c=>c.data.category===category).map(course=><CourseCard {course} lang="en"/>)}</div></section>)}</div></section><section class="learning-paths section"><div class="container"><p class="eyebrow">Learning paths</p><h2>Connected routes to progress with purpose.</h2><div class="grid grid-3"><article class="card"><h3>Cloud & AWS essentials</h3><p class="muted">Understand Cloud and build a practical foundation in AWS.</p><div class="path-courses"><span>Cloud Computing</span><b>→</b><span>Introduction to AWS</span><b>→</b><span>Practical AWS</span></div></article><article class="card"><h3>Building on AWS</h3><p class="muted">For teams ready to design maintainable systems.</p><div class="path-courses"><span>Practical AWS</span><b>→</b><span>Serverless</span><b>→</b><span>Infrastructure as Code</span></div></article><article class="card"><h3>Applied AI</h3><p class="muted">Understand Generative AI and take it into products and processes.</p><div class="path-courses"><span>AI for professionals</span><b>→</b><span>GenAI on AWS</span><b>→</b><span>GenAI applications</span></div></article></div></div></section></BaseLayout><style>.page-head{padding:100px 0 55px;background:#e8f0fc}.page-head .button{margin-top:22px}.course-group{margin-bottom:70px}.course-group>.eyebrow{border-bottom:1px solid var(--line);padding-bottom:12px}.learning-paths{background:#edf2f8}.learning-paths h2{margin-bottom:32px}.path-courses{display:flex;align-items:center;gap:7px;margin-top:20px;color:var(--blue);font-size:.77rem;font-weight:700}.path-courses span{flex:1;padding:8px;background:#fff;border:1px solid #d4dfec;border-radius:7px;line-height:1.3}.path-courses b{font-size:1rem}@media(max-width:720px){.path-courses{align-items:stretch;flex-direction:column}.path-courses b{align-self:center;transform:rotate(90deg)}}</style>
