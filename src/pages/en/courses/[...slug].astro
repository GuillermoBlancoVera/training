---
import { getCollection } from 'astro:content'; import BaseLayout from '../../../layouts/BaseLayout.astro'; import CourseCard from '../../../components/CourseCard.astro'; import { enCourses, categoryEn, levelEn } from '../../../i18n/en'; import { internalPath } from '../../../lib/paths';
export async function getStaticPaths(){const courses=await getCollection('courses');return courses.map(course=>({params:{slug:course.id},props:{course}}));}
const { course }=Astro.props; const copy=enCourses[course.id]; const related=(await getCollection('courses')).filter(item=>item.data.category===course.data.category&&item.id!==course.id).slice(0,3);
---
<BaseLayout lang="en" title={`${copy.title} | Guillermo Blanco Vera`} description={copy.description}><section class="course-hero"><div class="container"><a class="back no-print" href={internalPath('/en/courses')}>← Back to catalogue</a><p class="eyebrow">{categoryEn[course.data.category]}</p><h1>{copy.title}</h1><p class="lead">{copy.description}</p><div class="facts"><span>{levelEn[course.data.level]}</span><span>{course.data.duration.replace('horas', 'hours').replace('hora', 'hour')}</span><span>On-site, online or hybrid</span></div><div class="button-row no-print"><a class="button" href={internalPath('/en/contact')}>Request this training</a><button class="button secondary" onclick="window.print()">Print course sheet</button></div></div></section><section class="section"><div class="container course-layout"><div class="prose"><h2>Learning objectives</h2><p>Build a practical understanding of the key concepts and apply them to decisions and situations relevant to your role.</p><h2>Curriculum</h2><ul>{course.data.tags.map(tag=><li>{tag}: concepts, practical patterns and real-world examples.</li>)}</ul><h2>Methodology</h2><p>Clear explanations, real architecture and practical exercises. The balance of theory and hands-on work is adapted to the audience.</p></div><aside class="card details"><h3>Course details</h3><div><b>Who it is for</b><p>Business and technical professionals who want to understand and apply this subject in their work.</p></div><div><b>Previous knowledge</b><p>Requirements are adapted to the selected level and the needs of the group.</p></div><div><b>Possible exercises</b><p>Architecture reviews, guided practical tasks and examples based on real professional situations.</p></div><div><b>Company adaptation</b><p>Duration, technical depth and exercises can be adapted to your organisation.</p></div></aside></div></section>{related.length>0&&<section class="section related"><div class="container"><p class="eyebrow">You may also be interested in</p><div class="grid grid-3">{related.map(course=><CourseCard {course} lang="en"/>)}</div></div></section>}</BaseLayout><style>.course-hero{padding:65px 0;background:#e8f0fc}.back{display:inline-block;color:var(--muted);font-weight:600;margin-bottom:38px}.facts{display:flex;flex-wrap:wrap;gap:10px;margin-top:27px}.facts span{background:#fff;border:1px solid var(--line);border-radius:7px;padding:7px 10px;font-size:.86rem;font-weight:700}.course-hero .button-row{margin-top:28px}.course-layout{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(290px,.8fr);gap:70px}.details{height:max-content}.details div{border-top:1px solid var(--line);padding:15px 0}.details p,.details ul{font-size:.9rem;color:var(--muted);margin:7px 0 0;padding-left:18px}.related{background:#edf2f8}@media(max-width:720px){.course-layout{grid-template-columns:1fr;gap:32px}}</style>
