---
import BaseLayout from '../layouts/BaseLayout.astro';
const timeline=[['2024 — Actualidad','Volkswagen Digital:Hub','Senior Software Engineer','Arquitecturas Cloud sobre AWS y sistemas empresariales: datos, integración, event-driven, observabilidad e infraestructura como código.'],['2023 — 2024','Padmi','CTO','Liderazgo de equipos de Computer Vision, iOS y Android; arquitectura Cloud, IA, backend y decisiones de producto.'],['2020 — 2023','Alyze','CTO','Desarrollo de un motor de IA para análisis de emociones mediante reconocimiento facial, con responsabilidad técnica, de producto e infraestructura.']];
---
<BaseLayout title="Experiencia | Guillermo Blanco Vera"><section class="page-head"><div class="container"><p class="eyebrow">Trayectoria profesional</p><h1>Más de 10 años desarrollando tecnología.</h1><p class="lead">Una trayectoria que une software, backend, Cloud, liderazgo técnico e Inteligencia Artificial; siempre con foco en convertir tecnología compleja en sistemas útiles.</p></div></section><section class="section"><div class="container"><div class="evolution"><span>Software Development</span><i>→</i><span>Backend & Cloud</span><i>→</i><span>Technical Leadership</span><i>→</i><span>Artificial Intelligence</span><i>→</i><span>Enterprise AWS</span></div><div class="timeline">{timeline.map(([date,company,role,text])=><article class="timeline-item"><p class="eyebrow">{date}</p><div class="timeline-dot"></div><h2>{company}</h2><h3>{role}</h3><p class="muted">{text}</p></article>)}</div></div></section><section class="section earlier"><div class="container"><p class="eyebrow">Experiencia anterior</p><div class="grid grid-3"><article><h3>Lendin</h3><p class="muted">Co-Founder. Desarrollo Full Stack de una aplicación peer-to-peer con React Native, Node.js, Java y Cloud.</p></article><article><h3>Integrasys · UC3M</h3><p class="muted">Desarrollo iOS y sistemas de comunicaciones por satélite; proyectos de AR/VR con Unity y C#.</p></article><article><h3>Investigación y móvil</h3><p class="muted">Machine Learning en el Hospital de La Princesa y aplicaciones iOS corporativas en Slashmobility.</p></article></div></div></section><section class="section"><div class="container grid grid-2"><article class="card"><p class="eyebrow">Formación</p><h3>Ingeniero de Telecomunicación</h3><p class="muted">Universidad Carlos III de Madrid</p><h3>Máster en Multimedia y Comunicaciones</h3><p class="muted">Universidad Carlos III de Madrid</p></article><article class="card"><p class="eyebrow">Certificaciones AWS</p><h3>AWS Certified Cloud Practitioner</h3><h3>AWS Certified AI Practitioner</h3><p class="muted">Válida hasta mayo de 2029</p></article></div></section></BaseLayout>
<style>.page-head{padding:100px 0 55px;background:#e8f0fc}.evolution{display:flex;align-items:center;gap:11px;flex-wrap:wrap;background:var(--ink);color:#fff;padding:22px;border-radius:12px;font-size:.85rem;font-weight:700}.evolution i{color:#85a9f5;font-style:normal}.timeline{max-width:800px;margin:70px auto}.timeline-item{position:relative;padding:0 0 48px 50px;border-left:1px solid var(--line)}.timeline-item:last-child{padding-bottom:0}.timeline-dot{position:absolute;left:-7px;top:2px;width:13px;height:13px;border-radius:50%;background:var(--blue);border:3px solid var(--canvas)}.timeline-item h2{font-size:1.8rem;margin-bottom:4px}.timeline-item h3{font-family:'DM Sans';letter-spacing:0;font-size:1rem;margin-bottom:9px}.earlier{background:#edf2f8}.earlier article{padding:10px}@media(max-width:720px){.page-head{padding:75px 0 45px}}</style>
