---
import { getCollection } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; import CourseCard from '../components/CourseCard.astro'; import { internalPath } from '../lib/paths';
const featured = (await getCollection('courses')).filter(c=>c.data.featured).sort((a,b)=>a.data.order-b.data.order).slice(0,3);
---
<BaseLayout><section class="hero"><div class="container"><p class="eyebrow">Guillermo Blanco Vera</p><h1>Formación tecnológica para empresas y profesionales.</h1><p class="lead">Cloud, AWS, programación e Inteligencia Artificial explicados desde la experiencia práctica.</p><div class="button-row"><a class="button" href={internalPath('/courses')}>Ver cursos</a><a class="button secondary" href={internalPath('/about')}>Conocer mi experiencia</a></div><div class="hero-note"><span>Senior Software Engineer</span><span>AWS · Backend · IA</span><span>+10 años de experiencia</span></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Áreas de formación</p><h2>Conceptos claros. Aplicación real.</h2></div></div><div class="grid grid-3 areas"><article class="card"><b>01</b><h3>Cloud & AWS</h3><p>Arquitecturas, servicios, seguridad, costes e infraestructura como código para comprender y construir en la nube.</p></article><article class="card"><b>02</b><h3>Programación</h3><p>Fundamentos y herramientas prácticas para automatizar, entender sistemas y desarrollar software.</p></article><article class="card"><b>03</b><h3>Inteligencia Artificial</h3><p>Desde las bases de IA hasta aplicaciones generativas, LLM y servicios de AWS.</p></article></div></div></section>
<section class="section featured"><div class="container"><div class="section-heading"><div><p class="eyebrow">Cursos destacados</p><h2>Formación que se adapta al contexto.</h2></div><a class="button secondary no-print" href={internalPath('/courses')}>Ver catálogo completo</a></div><div class="grid grid-3">{featured.map(course=><CourseCard {course}/>)}</div></div></section>
<section class="section"><div class="container split"><div><p class="eyebrow">Experiencia profesional</p><h2>Más de 10 años desarrollando tecnología.</h2></div><div><p class="lead">La formación parte de experiencia en desarrollo de software, backend, Cloud, liderazgo técnico, Computer Vision e Inteligencia Artificial; desde startups hasta sistemas empresariales sobre AWS.</p><a class="text-link" href={internalPath('/about')}>Ver trayectoria profesional →</a></div></div></section>
<section class="section certifications"><div class="container"><p class="eyebrow">Certificaciones AWS</p><div class="grid grid-2"><article class="card cert"><div><h3>AWS Certified Cloud Practitioner</h3><p class="muted">Fundamentos de arquitectura Cloud, seguridad, servicios y costes en AWS.</p></div></article><article class="card cert"><div><h3>AWS Certified AI Practitioner</h3><p class="muted">Conocimientos de Inteligencia Artificial, IA generativa y servicios de IA en AWS.</p></div></article></div></div></section>
<section class="section"><div class="container callout"><p class="eyebrow">Formación a medida</p><h2>¿Buscas una formación adaptada a tu equipo?</h2><p>Los cursos pueden ajustarse en duración, nivel y contenidos según las necesidades de cada empresa.</p><a class="button" href={internalPath('/contact')}>Hablemos de la formación</a></div></section>
</BaseLayout>
<style>.hero{padding:125px 0 96px;background:linear-gradient(120deg,#f6f8fb 45%,#e8f0fc)}.hero h1{margin-bottom:20px}.hero .button-row{margin-top:32px}.hero-note{display:flex;gap:22px;flex-wrap:wrap;margin-top:70px;padding-top:20px;border-top:1px solid var(--line);font-size:.85rem;font-weight:700;color:var(--muted)}.areas article b{color:var(--blue);font-size:.8rem}.areas h3{margin:20px 0 8px}.areas p{margin:0;color:var(--muted)}.featured{background:#edf2f8}.split{display:grid;grid-template-columns:1fr 1fr;gap:90px}.text-link{color:var(--blue);font-weight:700}@media(max-width:720px){.hero{padding:80px 0 60px}.split{grid-template-columns:1fr;gap:10px}}</style>
